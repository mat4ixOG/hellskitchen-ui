{
  "name": "hellskitchen-ui-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && ng serve",
    "build": "npm run build:lib && ng build",
    "watch": "npm run build:lib && ng build --watch --configuration development",
    "test": "npm run build:lib && ng test",
    "build:lib": "ng build hk-ui",
    "test:lib": "ng test hk-ui",
    "test:all": "npm run build:lib && ng test hk-ui --watch=false --browsers=ChromeHeadless && ng test hk-docs --watch=false --browsers=ChromeHeadless",
    "pack:lib": "npm run build:lib && cd dist/hk-ui && npm pack",
    "publish:lib": "npm run build:lib && cd dist/hk-ui && npm publish"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@primeng/themes": "^19.1.4",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.26",
    "primeicons": "^8.0.0",
    "primeng": "^19.1.4",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "typescript": "~5.7.2"
  },
  "description": "Workspace for hellskitchen-ui — the library lives in projects/hk-ui, the docs site in src."
}
