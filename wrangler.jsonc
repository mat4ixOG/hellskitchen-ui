{
  // Cloudflare Workers static-assets config for the docs site.
  //
  // The site is fully prerendered: `npm run build:site` emits a real HTML file
  // per route, so there is no server-side code and no `main` entry — Cloudflare
  // just serves files.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hellskitchen-ui",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist/hk-docs/browser",
    // Serves /404.html with a real 404 status for unmatched paths. NOT
    // "single-page-application" — that would answer every bad URL with
    // index.html on a 200, which is the soft-404 problem we just removed.
    "not_found_handling": "404-page"
  }
}
